# ===== 服务 =====
PORT=3001

# 留空 = 不校验；对外部署时填一个随机串，前端请求带 Authorization: Bearer <token>
API_TOKEN=

# 平台管理员邮箱，逗号分隔；仅这些账号以 superadmin 身份进入管理面板
SUPERADMIN_EMAILS=

# 媒体生成：mock（本地占位图）| ark（方舟 Seedream/Seedance）| jimeng（智能视觉 AK/SK）
MEDIA_PROVIDER=mock

# 文本模型：mock（模板回复）| ark（豆包）
LLM_PROVIDER=mock

# ===== 火山方舟（豆包 / Seedream / Seedance）=====
# 控制台 API Key：https://console.volcengine.com/ark（API Key 管理）
# 填完这里把 MEDIA_PROVIDER / LLM_PROVIDER 改成 ark，然后重启后端
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型 ID 以你控制台实际开通的为准，也可以用推理接入点 ep-xxxx
ARK_MODEL=Doubao-Seed-2.1-lite
ARK_IMAGE_MODEL=Doubao-Seedream-5.0-flash
ARK_VIDEO_MODEL=Doubao-Seedance-2.5-flash
ARK_TIMEOUT_MS=60000
ARK_THINKING=disabled

# ===== 即梦（火山智能视觉，AK/SK 签名，和上面的 API Key 不是一套）=====
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
JIMENG_REQ_KEY_IMAGE=jimeng_t2i_v40
JIMENG_REQ_KEY_VIDEO=jimeng_t2v_v30

# ===== 任务 =====
POLL_INTERVAL_MS=1200
TASK_TIMEOUT_MS=900000
MAX_ATTEMPTS=3

# ===== 积分定价 =====
# 1 积分折合多少元人民币，用于把真实成本换算成消耗积分
# 默认 0.12 对齐一张 Seedream 图，所以图片任务正好 1 积分
CREDIT_CNY=0.12
